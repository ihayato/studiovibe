# デプロイ実行者の秘密鍵(コントラクトownerになる。コールドウォレット推奨)
DEPLOYER_PRIVATE_KEY=

# ownerを別アドレスにする場合のみ指定。省略時はデプロイ実行者
OWNER_ADDRESS=

# サーバーミント用ホットウォレットのアドレス(サイト側MINTER_PRIVATE_KEYと対)
MINTER_ADDRESS=

# tokenURIの基底。末尾スラッシュ必須
BASE_TOKEN_URI=https://vibe.co.jp/api/nft/meta/

# 上限枚数。オープンエディションなので既定は100万(省略可)
MAX_SUPPLY=1000000

# コントラクト検証用(任意)
BASESCAN_API_KEY=
