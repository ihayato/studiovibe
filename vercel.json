{
    "cleanUrls": true,
    "buildCommand": "vite build",
    "outputDirectory": "dist",
    "framework": "vite",
    "redirects": [
        {
            "source": "/luna-occulta/",
            "destination": "/luna-occulta",
            "permanent": false
        },
        {
            "source": "/mitaseo",
            "destination": "/mitaseo/",
            "permanent": false
        },
        {
            "source": "/otetsudai",
            "destination": "/otetsudai/",
            "permanent": false
        },
        {
            "source": "/hankacho",
            "destination": "/hankacho/",
            "permanent": false
        },
        {
            "source": "/sakuya",
            "destination": "/sakuya/",
            "permanent": false
        },
        {
            "source": "/sagetsu/",
            "destination": "/sagetsu",
            "permanent": false
        },
        {
            "source": "/luna-catenata/",
            "destination": "/luna-catenata",
            "permanent": false
        },
        {
            "source": "/ikkyo",
            "destination": "/ikkyo/",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/contract_202607",
            "destination": "/api/contract-202607"
        },
        {
            "source": "/149e9513-01fa-4fb0-aad4-566afd725d1b/2d206a39-8ed7-437e-a3be-862e0f06eea3/:path*",
            "destination": "https://cn-kitan-web.vercel.app/luna-occulta/149e9513-01fa-4fb0-aad4-566afd725d1b/2d206a39-8ed7-437e-a3be-862e0f06eea3/:path*"
        },
        {
            "source": "/island",
            "destination": "/poc/island/"
        },
        {
            "source": "/ochanoma-news",
            "destination": "https://ochanoma-news-site.vercel.app/ochanoma-news"
        },
        {
            "source": "/ochanoma-news/:path*",
            "destination": "https://ochanoma-news-site.vercel.app/:path*"
        },
        {
            "source": "/sakuya/",
            "destination": "https://sakuya-site.vercel.app/"
        },
        {
            "source": "/sakuya/:path*",
            "destination": "https://sakuya-site.vercel.app/:path*"
        },
        {
            "source": "/hankacho/",
            "destination": "https://ninja-hankacho-site.vercel.app/"
        },
        {
            "source": "/hankacho/:path*",
            "destination": "https://ninja-hankacho-site.vercel.app/:path*"
        },
        {
            "source": "/mitaseo/",
            "destination": "https://mitama-seori-site.vercel.app/"
        },
        {
            "source": "/mitaseo/:path*",
            "destination": "https://mitama-seori-site.vercel.app/:path*"
        },
        {
            "source": "/luna-occulta",
            "destination": "https://cn-kitan-web.vercel.app/luna-occulta"
        },
        {
            "source": "/luna-occulta/:path*",
            "destination": "https://cn-kitan-web.vercel.app/luna-occulta/:path*"
        },
        {
            "source": "/sagetsu",
            "destination": "https://sagetsu-web.vercel.app/sagetsu"
        },
        {
            "source": "/sagetsu/:path*",
            "destination": "https://sagetsu-web.vercel.app/sagetsu/:path*"
        },
        {
            "source": "/luna-catenata",
            "destination": "https://sagetsu-web.vercel.app/luna-catenata"
        },
        {
            "source": "/luna-catenata/:path*",
            "destination": "https://sagetsu-web.vercel.app/luna-catenata/:path*"
        },
        {
            "source": "/blog",
            "destination": "/blog.html"
        },
        {
            "source": "/blog/:slug",
            "destination": "/blog-post.html"
        },
        {
            "source": "/ikkyo/",
            "destination": "https://ikkyo-web.vercel.app/"
        },
        {
            "source": "/ikkyo/:path*",
            "destination": "https://ikkyo-web.vercel.app/:path*"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=()"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=63072000; includeSubDomains; preload"
                }
            ]
        },
        {
            "source": "/149e9513-01fa-4fb0-aad4-566afd725d1b/2d206a39-8ed7-437e-a3be-862e0f06eea3/:path*",
            "headers": [
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "frame-ancestors 'self'"
                }
            ]
        }
    ]
}
