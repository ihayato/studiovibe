{
    "cleanUrls": true,
    "buildCommand": "vite build",
    "outputDirectory": "dist",
    "framework": "vite",
    "redirects": [
        {
            "source": "/luna-occulta/",
            "destination": "/luna-occulta",
            "permanent": false
        },
        {
            "source": "/mitaseo",
            "destination": "/mitaseo/",
            "permanent": false
        },
        {
            "source": "/otetsudai",
            "destination": "/otetsudai/",
            "permanent": false
        },
        {
            "source": "/hankacho",
            "destination": "/hankacho/",
            "permanent": false
        },
        {
            "source": "/sakuya",
            "destination": "/sakuya/",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/sakuya/",
            "destination": "https://sakuya-site.vercel.app/"
        },
        {
            "source": "/sakuya/:path*",
            "destination": "https://sakuya-site.vercel.app/:path*"
        },
        {
            "source": "/hankacho/",
            "destination": "https://ninja-hankacho-site.vercel.app/"
        },
        {
            "source": "/hankacho/:path*",
            "destination": "https://ninja-hankacho-site.vercel.app/:path*"
        },
        {
            "source": "/mitaseo/",
            "destination": "https://mitama-seori-site.vercel.app/"
        },
        {
            "source": "/mitaseo/:path*",
            "destination": "https://mitama-seori-site.vercel.app/:path*"
        },
        {
            "source": "/luna-occulta",
            "destination": "https://cn-kitan-web.vercel.app/luna-occulta"
        },
        {
            "source": "/luna-occulta/:path*",
            "destination": "https://cn-kitan-web.vercel.app/luna-occulta/:path*"
        },
        {
            "source": "/blog",
            "destination": "/blog.html"
        },
        {
            "source": "/blog/:slug",
            "destination": "/blog-post.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=()"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=63072000; includeSubDomains; preload"
                }
            ]
        }
    ]
}
